# No key is required. Weather and chat both use the free Open-Meteo API.
# A model key is optional. If you add one, the chat uses that model instead.

OPENAI_API_KEY=
# LLM_MODEL=openai:gpt-4o-mini

# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# LLM_MODEL=google_genai:gemini-3.7-flash

# GROQ_API_KEY=
# LLM_MODEL=groq:openai/gpt-oss-20b

# Weather data comes from Open-Meteo and does not need a key.
# https://open-meteo.com/en/docs
